<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>LibTmux.Mcp</AssemblyName>
    <RootNamespace>LibTmux.Mcp</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>libtmux-mcp</ToolCommandName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>LibTmux.Mcp</PackageId>
    <Description>A Model Context Protocol server that lets an assistant drive tmux through LibTmux.</Description>
    <PackageTags>tmux;mcp;model-context-protocol;ai</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- A tool package carries its own binaries and their symbols under
         tools/, so a symbols package beside it would hold a second copy of
         what already shipped. -->
    <IncludeSymbols>false</IncludeSymbols>

    <!-- The server binds tool parameters by reflection, so it is not trimmed. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibTmux\LibTmux.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
    <InternalsVisibleTo Include="LibTmux.IntegrationTests" />
  </ItemGroup>
</Project>

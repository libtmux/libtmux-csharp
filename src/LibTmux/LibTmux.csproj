<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>LibTmux</AssemblyName>
    <RootNamespace>LibTmux</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- RS0016 is the rule worth having: it fails the build when the public
         surface grows without being written down. The other three cannot be
         satisfied while multi-targeting, because each framework reports the
         same record members with its own nullability, so an entry that
         satisfies one is unused by the other. RS0026 objects to the optional
         parameters the reviewed surface is built from. -->
    <NoWarn>$(NoWarn);RS0017;RS0026;RS0036</NoWarn>

    <PackageId>LibTmux</PackageId>
    <Description>A typed, async-first client for the tmux terminal multiplexer. Drive servers, sessions, windows, panes, options, hooks, and buffers from .NET.</Description>
    <PackageTags>tmux;terminal;multiplexer;automation;pty</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Debugging a tmux problem means reading this library's source, so the
         symbols and the sources they point at ship alongside the package. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/tmux-python/libtmux</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- The library reflects over nothing, so a trimmed or ahead-of-time
         published app keeps everything it needs. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The analyzer reads these, and they are what makes an unintended change
         to the public surface a build failure rather than a release note. -->
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LibTmux.UnitTests" />
    <InternalsVisibleTo Include="LibTmux.IntegrationTests" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Analyzer reference: the generator runs at compile time and must not
         become a runtime dependency of the shipped library. -->
    <ProjectReference Include="..\LibTmux.Generators\LibTmux.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>

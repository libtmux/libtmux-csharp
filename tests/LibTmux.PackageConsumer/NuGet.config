<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The consumer restores from the package this repository just built, not
       from a feed. Proving the package works means proving it works before
       anybody publishes it. -->
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
  </packageSources>
</configuration>

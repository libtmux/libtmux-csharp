<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LibTmux.Examples</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LibTmux\LibTmux.csproj" />

    <!-- Real tmux runs here, so this assembly claims a socket root of its own. -->
    <Compile Include="../../eng/dotnet/WorkspaceSocketRoot.cs"
             Link="WorkspaceSocketRoot.cs" />
  </ItemGroup>
</Project>
